---
import { animals, profiles, getThreshold, formatThreshold, matchupSlug, type Range } from '../lib/model';
import { animalIcon, profileIcon } from '../lib/icons';
function tagClass(t: Range): string {
  if (t === null) return 'bad';
  if (t[1] <= 3) return 'ok';
  if (t[1] <= 30) return 'warn';
  return 'bad';
}
---
<div class="table-wrap">
  <table>
    <caption>Nombre d'humains nécessaires pour une victoire quasi certaine (espace clos, animal adulte enragé). Cliquez sur une case pour l'analyse détaillée.</caption>
    <thead>
      <tr>
        <th scope="col">Animal</th>
        {profiles.map((p) => <th scope="col"><a href={`/profils/${p.slug}/`}><span class="ico" set:html={profileIcon(p.slug)} /> {p.shortName}</a></th>)}
      </tr>
    </thead>
    <tbody>
      {animals.map((a) => (
        <tr>
          <th scope="row"><a href={`/animaux/${a.slug}/`}><span class="ico" set:html={animalIcon(a.slug)} /> {a.name}</a> <span class="note">({a.weight} kg)</span></th>
          {profiles.map((p) => {
            const t = getThreshold(a.slug, p.slug);
            return <td><a href={`/combats/${matchupSlug(a, p)}/`}><span class={`tag ${tagClass(t)}`}>{formatThreshold(t)}</span></a></td>;
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
