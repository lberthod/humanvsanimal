---
import Base from '../../layouts/Base.astro';
import { animals } from '../../lib/model';
const title = 'Les animaux : gorille, chimpanzé, lion, ours, loup, crocodile';
const description = 'Fiches des animaux du simulateur : poids, létalité, forces et faiblesses face à un groupe d\'humains.';
---
<Base {title} {description}>
  <h1>Les animaux</h1>
  <p class="lead">Six adversaires classés du plus abordable au plus terrifiant pour un groupe d'humains.</p>
  <div class="grid">
    {animals.map((a) => (
      <a class="card" href={`/animaux/${a.slug}/`} style="text-decoration:none;color:inherit">
        <div class="emoji">{a.emoji}</div>
        <h3>{a.name}</h3>
        <p class="note">{a.weight} kg · létalité {a.lethality}/4</p>
        <p>{a.description}</p>
      </a>
    ))}
  </div>
</Base>
