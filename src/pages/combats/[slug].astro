---
import Base from '../../layouts/Base.astro';
import Simulator from '../../components/Simulator.vue';
import { animals, profiles, getThreshold, formatThreshold, matchupSlug, simulate } from '../../lib/model';
export function getStaticPaths() {
  return animals.flatMap((a) => profiles.map((p) => ({ params: { slug: matchupSlug(a, p) }, props: { animal: a, profile: p } })));
}
const { animal, profile } = Astro.props;
const threshold = getThreshold(animal.slug, profile.slug);
const count = threshold ? threshold[1] : 50;
const sim = simulate(animal, profile, count);
const plural = profile.name.toLowerCase();
const title = threshold
  ? `Combien de ${plural} pour battre un ${animal.name.toLowerCase()} ? ${formatThreshold(threshold)}`
  : `${profile.name} contre ${animal.name.toLowerCase()} : mission impossible`;
const description = threshold
  ? `Il faut ${formatThreshold(threshold)} ${plural} pour vaincre un ${animal.name.toLowerCase()} de ${animal.weight} kg, au prix d'environ ${sim.humanDeaths} mort(s) et ${sim.humanSevere} blessé(s) grave(s). Analyse du déroulement du combat.`
  : `Quel que soit leur nombre, des ${plural} ne peuvent pas venir à bout d'un ${animal.name.toLowerCase()} de ${animal.weight} kg. Explication.`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description, inLanguage: 'fr',
  mainEntityOfPage: Astro.url.href, author: { '@type': 'Organization', name: 'Humain vs Animal' },
};
const others = animals.filter((a) => a.slug !== animal.slug);
const otherProfiles = profiles.filter((p) => p.slug !== profile.slug);
---
<Base {title} {description} {jsonLd} type="article">
  <p class="breadcrumb"><a href="/">Accueil</a> › <a href="/combats/">Combats</a> › {profile.name} vs {animal.name}</p>
  <h1>{profile.emoji} {profile.name} vs {animal.emoji} {animal.name}</h1>
  {threshold ? (
    <p class="lead">Verdict : il faut <strong>{formatThreshold(threshold)} {plural}</strong> pour une victoire quasi certaine contre un {animal.name.toLowerCase()} de {animal.weight} kg.</p>
  ) : (
    <p class="lead">Verdict : <strong>impossible</strong>. Le nombre ne compense pas la fragilité de ce profil face à un {animal.name.toLowerCase()} de {animal.weight} kg.</p>
  )}

  <div class="two-col">
    <div class="card">
      <h3>{profile.emoji} {profile.name} ({profile.weight} kg)</h3>
      <p>{profile.description}</p>
      <p class="note"><a href={`/profils/${profile.slug}/`}>Fiche du profil →</a></p>
    </div>
    <div class="card">
      <h3>{animal.emoji} {animal.name} ({animal.weight} kg)</h3>
      <p>{animal.description}</p>
      <p class="note"><a href={`/animaux/${animal.slug}/`}>Fiche de l'animal →</a></p>
    </div>
  </div>

  <h2>Déroulement du combat à {count} contre 1</h2>
  <ul class="clean">{sim.narrative.map((l) => <li>{l}</li>)}</ul>

  <h2>Bilan estimé</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Humains engagés</th><th>Morts</th><th>Blessés graves</th><th>Blessés légers</th><th>Animal vaincu</th></tr></thead>
      <tbody><tr><td>{count}</td><td>{sim.humanDeaths}</td><td>{sim.humanSevere}</td><td>{sim.humanLight}</td><td>{sim.animalDies ? 'Oui' : 'Non'}</td></tr></tbody>
    </table>
  </div>

  <h2>Testez d'autres effectifs</h2>
  <Simulator client:visible animal={animal.slug} profile={profile.slug} count={count} />

  <h2>Le même profil contre d'autres animaux</h2>
  <ul class="clean">
    {others.map((a) => <li><a href={`/combats/${matchupSlug(a, profile)}/`}>{profile.name} vs {a.name}</a> : {formatThreshold(getThreshold(a.slug, profile.slug))}</li>)}
  </ul>
  <h2>D'autres profils contre {animal.name.toLowerCase()}</h2>
  <ul class="clean">
    {otherProfiles.map((p) => <li><a href={`/combats/${matchupSlug(animal, p)}/`}>{p.name} vs {animal.name}</a> : {formatThreshold(getThreshold(animal.slug, p.slug))}</li>)}
  </ul>
</Base>
