---
import Base from '../../layouts/Base.astro';
import { animals, profiles, getThreshold, formatThreshold, matchupSlug } from '../../lib/model';
import { animalIcon, profileIcon } from '../../lib/icons';
export function getStaticPaths() {
  return profiles.map((p) => ({ params: { slug: p.slug }, props: { profile: p } }));
}
const { profile } = Astro.props;
const title = `${profile.name} : combien en faut-il contre chaque animal ?`;
const description = `${profile.description} Nombre nécessaire contre un loup, un chimpanzé, un lion, un gorille, un ours et un crocodile.`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: title, description, inLanguage: 'fr',
    mainEntityOfPage: Astro.url.href, author: { '@type': 'Organization', name: 'Humain vs Animal' },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Profils', item: new URL('/profils/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: profile.name, item: Astro.url.href },
    ],
  },
];
---
<Base {title} {description} {jsonLd} type="article">
  <p class="breadcrumb"><a href="/">Accueil</a> › <a href="/profils/">Profils</a> › {profile.name}</p>
  <h1><span class="ico" set:html={profileIcon(profile.slug)} /> {title}</h1>
  <p class="lead">{profile.description}</p>
  <div class="two-col">
    <div class="card"><h3>Atouts</h3><ul class="clean">{profile.strengths.map((s) => <li>{s}</li>)}</ul></div>
    <div class="card"><h3>Faiblesses</h3><ul class="clean">{profile.weaknesses.map((s) => <li>{s}</li>)}</ul></div>
  </div>
  <h2>Nombre nécessaire par animal</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Animal</th><th>Humains nécessaires</th><th>Analyse</th></tr></thead>
      <tbody>
        {animals.map((a) => (
          <tr>
            <td><span class="ico" set:html={animalIcon(a.slug)} /> {a.name} <span class="note">({a.weight} kg)</span></td>
            <td><span class={`tag ${getThreshold(a.slug, profile.slug) === null ? 'bad' : 'ok'}`}>{formatThreshold(getThreshold(a.slug, profile.slug))}</span></td>
            <td><a href={`/combats/${matchupSlug(a, profile)}/`}>Voir le combat →</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p><a class="btn" href={`/simulateur/?profil=${profile.slug}`}>Simuler avec ce profil</a></p>
</Base>
